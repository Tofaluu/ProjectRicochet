<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="App.uss" />
    <ui:VisualElement name="app" class="app" picking-mode="Ignore">

        <!-- Compact layout only (phones, tablets upright): brand, Settings and the profile; the nav becomes a bottom tab bar. -->
        <ui:VisualElement name="topbar" class="topbar">
            <ui:VisualElement class="brand-dots">
                <ui:VisualElement class="dot dot--red" />
                <ui:VisualElement class="dot dot--blue" />
                <ui:VisualElement class="dot dot--green" />
                <ui:VisualElement class="dot dot--yellow" />
            </ui:VisualElement>
            <ui:Label text="Ricochet" class="topbar-name" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="topbar-settings" text="Settings" class="btn btn--small topbar-settings" />
            <ui:Label name="topbar-avatar" text="?" class="avatar topbar-avatar" />
        </ui:VisualElement>

        <ui:VisualElement name="nav" class="nav">
            <ui:VisualElement class="brand">
                <ui:VisualElement class="brand-dots">
                    <ui:VisualElement class="dot dot--red" />
                    <ui:VisualElement class="dot dot--blue" />
                    <ui:VisualElement class="dot dot--green" />
                    <ui:VisualElement class="dot dot--yellow" />
                </ui:VisualElement>
                <ui:Label text="Ricochet" class="brand-name" />
            </ui:VisualElement>
            <ui:Button name="nav-home" text="Home" class="nav-item" />
            <ui:Button name="nav-daily" text="Daily puzzle" class="nav-item" />
            <ui:Button name="nav-play" text="Play with friends" class="nav-item" />
            <ui:Button name="nav-practice" text="Practice" class="nav-item" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="nav-settings" text="Settings" class="nav-item" />
            <ui:VisualElement class="profile">
                <ui:VisualElement name="profile-button" class="profile-button">
                    <ui:VisualElement class="profile-row">
                        <ui:Label name="profile-avatar" text="?" class="avatar" />
                        <ui:Label name="profile-name" text="Guest" class="profile-name" />
                    </ui:VisualElement>
                    <ui:Label text="Playing as a guest" class="profile-sub" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="main" class="main" picking-mode="Ignore">
            <ui:VisualElement name="stage" class="stage" picking-mode="Ignore">
                <ui:VisualElement class="stage-head" picking-mode="Ignore">
                    <ui:VisualElement class="goal" picking-mode="Ignore">
                        <ui:VisualElement name="goal-icon" class="goal-icon" picking-mode="Ignore" />
                        <ui:Label name="goal-label" text="Get the robot to its target" class="goal-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="banner" text="Practice board" class="banner" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="board-area" class="board-area" picking-mode="Ignore" />
                <ui:VisualElement name="board-controls" class="board-controls">
                    <ui:VisualElement name="replay-bar" class="replay-bar">
                        <ui:Button name="replay-pause" text="Pause" class="btn" />
                        <ui:Button name="replay-back" text="&lt;" class="btn btn--square" />
                        <ui:Button name="replay-forward" text="&gt;" class="btn btn--square" />
                    </ui:VisualElement>
                    <ui:Button name="control-undo" text="Undo  (Z)" class="btn" />
                    <ui:Button name="control-reset" text="Reset  (R)" class="btn" />
                    <ui:Button name="control-new" text="New board  (N)" class="btn" />
                    <ui:Button name="control-shortest" text="Shortest  (H)" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:ScrollView name="side" class="side">

                <ui:VisualElement name="screen-home" class="screen">
                    <ui:Label name="home-title" text="Welcome to Ricochet" class="h1 gap-s" />
                    <ui:Label text="Slide the robots, find the shortest path to the target." class="muted body gap-l" />

                    <ui:VisualElement class="card card--daily">
                        <ui:VisualElement class="card-head">
                            <ui:VisualElement class="card-icon"><ui:VisualElement name="daily-icon-star" class="card-icon-star" /></ui:VisualElement>
                            <ui:VisualElement class="card-title">
                                <ui:Label name="home-daily-title" text="Daily Puzzle" class="h2" />
                                <ui:Label text="New every day at midnight (Eastern)" class="muted small" />
                            </ui:VisualElement>
                            <ui:Label name="home-daily-streak" text="5-day streak" class="pill pill--daily" />
                        </ui:VisualElement>
                        <ui:Label text="One board for everyone. Fewest moves wins; your time counts from when you first open it." class="body gap-m" />
                        <ui:VisualElement class="row">
                            <ui:Button name="home-daily-play" text="Play today's puzzle" class="btn btn--daily" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="card">
                        <ui:Label text="Play with friends" class="h2 gap-s" />
                        <ui:Label text="Race your friends on the same board: the shortest solution wins the round." class="muted body gap-m" />
                        <ui:VisualElement class="row">
                            <ui:Button name="home-play" text="Create or join a lobby" class="btn btn--primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="card">
                        <ui:Label text="Practice" class="h2 gap-s" />
                        <ui:Label text="Play on a practice board any time. Puzzle mode deals boards that need exactly this many moves." class="muted body gap-m" />
                        <ui:VisualElement name="home-puzzle-row" class="setting-row gap-s" />
                        <ui:VisualElement name="home-stepper-slot" />
                        <ui:Button name="home-practice-open" text="Open the practice board" class="btn compact-only home-practice-open" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="screen-practice" class="screen">
                    <ui:Label text="Practice" class="h1 gap-s" />
                    <ui:Label text="Free play: no timer, no score. Try to match the shortest possible solution." class="muted body gap-l" />
                    <ui:VisualElement class="card">
                        <ui:Label text="PUZZLE MODE" class="h3 gap-s" />
                        <ui:VisualElement name="practice-puzzle-row" class="setting-row gap-s" />
                        <ui:VisualElement name="practice-stepper-slot" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:Label text="HOW TO PLAY" class="h3 gap-s" />
                        <ui:Label text="Robots slide until they hit a wall or another robot. Get the robot shown above onto its target in as few moves as you can." class="body gap-m" />
                        <ui:Label text="Click a robot, then click a dot to move it, or drag it. Keys: 1-4 or Tab to pick, arrows or WASD to move, Z undo, R reset, N new board, H shortest solution." class="muted small" />
                        <ui:Button name="practice-tutorial" text="Play the tutorial" class="btn btn--small tutorial-replay" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="screen-play" class="screen">
                    <ui:Label text="Play with friends" class="h1 gap-s" />
                    <ui:Label text="Everyone gets the same board. The first solution starts a timer, shorter ones extend it, and the shortest when time runs out wins the round." class="muted body gap-l" />
                    <ui:VisualElement class="card">
                        <ui:Label text="Your name" class="field-label" />
                        <ui:TextField name="play-name" max-length="20" class="field gap-m" />
                        <ui:Button name="play-create" text="Create a lobby" class="btn btn--primary gap-l" />
                        <ui:Label text="Or join with a code" class="field-label" />
                        <ui:VisualElement class="row">
                            <ui:TextField name="play-code" max-length="8" class="field field--code" />
                            <ui:Button name="play-join" text="Join" class="btn" style="margin-left: 8px;" />
                        </ui:VisualElement>
                        <ui:Label name="play-status" text="" class="muted small" style="margin-top: 10px;" />
                    </ui:VisualElement>
                    <ui:Label text="Share the lobby code with your friends. Whoever creates the lobby picks the settings and starts the match." class="muted small" />
                </ui:VisualElement>

                <ui:VisualElement name="screen-daily" class="screen">
                    <ui:Label name="daily-header" text="DAILY PUZZLE" class="h3 gap-s" />
                    <ui:VisualElement class="card card--daily">
                        <ui:Label name="daily-headline" text="" class="h2 gap-m" />
                        <ui:VisualElement name="daily-stats" class="row gap-m">
                            <ui:VisualElement class="stat"><ui:Label name="daily-moves" class="stat-value" /><ui:Label name="daily-moves-label" text="moves" class="stat-label" /></ui:VisualElement>
                            <ui:VisualElement class="stat"><ui:Label name="daily-time" class="stat-value" /><ui:Label text="time" class="stat-label" /></ui:VisualElement>
                            <ui:VisualElement class="stat stat--last"><ui:Label name="daily-streak" class="stat-value stat-value--daily" /><ui:Label text="day streak" class="stat-label" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="daily-detail" text="" class="muted body gap-m" />
                        <ui:VisualElement name="daily-squares" class="squares gap-m" />
                        <ui:Button name="daily-copy" text="Copy result" class="btn btn--daily" />
                        <ui:Button name="daily-retry" text="Try again" class="btn btn--primary" />
                        <ui:Label name="daily-notice" text="" class="notice" />
                    </ui:VisualElement>
                    <ui:VisualElement name="daily-board" class="card">
                        <ui:VisualElement class="row row--spread gap-s">
                            <ui:Label text="Today's leaderboard" class="h2" />
                            <ui:Label name="daily-rank" text="" class="muted small" />
                        </ui:VisualElement>
                        <ui:VisualElement name="daily-rows" />
                    </ui:VisualElement>
                    <ui:Label name="daily-next" text="" class="muted small gap-m" style="-unity-text-align: middle-center;" />
                    <ui:Button name="daily-back" text="Back to practice" class="btn" />
                </ui:VisualElement>

                <!-- Lobby: the waiting room before a match, and the results after one. AppUI orders the cards for each. -->
                <ui:VisualElement name="screen-lobby" class="screen">
                    <ui:Label name="lobby-title" text="Lobby" class="h1 gap-s" />
                    <ui:Label name="lobby-sub" text="" class="muted body gap-m" />
                    <ui:VisualElement name="lobby-standings" class="card card--gold">
                        <ui:Label text="FINAL STANDINGS" class="h3 gap-s" />
                        <ui:VisualElement name="lobby-standings-list" />
                    </ui:VisualElement>
                    <ui:VisualElement name="lobby-code-card" class="card">
                        <ui:Label text="LOBBY CODE" class="h3 gap-s" />
                        <ui:VisualElement class="row row--spread">
                            <ui:Label name="lobby-code" text="ABCD" class="code-big" />
                            <ui:VisualElement class="code-actions">
                                <ui:Button name="lobby-copy" text="Copy invite link" class="btn btn--small" />
                                <ui:Button name="lobby-copy-code" text="Copy code" class="btn btn--small" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="lobby-copied" text="" class="notice" />
                    </ui:VisualElement>
                    <ui:VisualElement name="lobby-players-card" class="card">
                        <ui:Label name="lobby-players-title" text="PLAYERS" class="h3 gap-s" />
                        <ui:VisualElement name="lobby-players" />
                        <ui:Label name="lobby-alone" text="Share the code to invite friends, or start on your own." class="muted small lobby-alone" />
                    </ui:VisualElement>
                    <ui:Button name="lobby-start" text="Start match" class="btn btn--primary gap-l" />
                    <ui:VisualElement name="lobby-history" class="card">
                        <ui:Label text="MATCH HISTORY" class="h3 gap-s" />
                        <ui:VisualElement name="history-list" />
                        <ui:Label text="Pick a board to see everyone's best and replay them." class="muted small" />
                    </ui:VisualElement>
                    <ui:VisualElement name="lobby-settings" class="card">
                        <ui:Label text="MATCH SETTINGS" class="h3 gap-s" />
                        <ui:VisualElement name="lobby-settings-list" />
                    </ui:VisualElement>
                    <ui:VisualElement name="lobby-settings-view" class="card">
                        <ui:Label text="MATCH SETTINGS" class="h3 gap-s" />
                        <ui:VisualElement name="lobby-settings-view-list" />
                    </ui:VisualElement>
                    <ui:Label name="lobby-feedback" text="" class="notice gap-m" />
                    <ui:Label name="lobby-tip" text="" class="muted small gap-m" />
                    <ui:Button name="lobby-leave" text="Leave lobby" class="link-quiet" />
                </ui:VisualElement>

                <ui:VisualElement name="screen-match" class="screen">
                    <ui:VisualElement class="row row--spread gap-l match-head">
                        <ui:Label name="match-title" text="Round 1" class="h1" />
                        <ui:Label name="match-sub" text="" class="muted small match-sub" />
                    </ui:VisualElement>
                    <!-- The round: its clock before and after the first solution, then its result while the replays play. -->
                    <ui:VisualElement name="round-card" class="card">
                        <ui:Label name="timer-caption" text="" class="h3 gap-s" />
                        <ui:VisualElement class="row timer-row">
                            <ui:Label name="timer-value" text="" class="timer-value" />
                            <ui:Label name="timer-unit" text="" class="body timer-unit" />
                        </ui:VisualElement>
                        <ui:Label name="round-detail" text="" class="round-detail" />
                        <ui:Label name="timer-sub" text="" class="muted body" />
                        <ui:VisualElement name="round-progress" class="round-progress">
                            <ui:VisualElement name="round-progress-fill" class="round-progress-fill" />
                        </ui:VisualElement>
                        <ui:VisualElement name="match-best-box" class="best-box">
                            <ui:VisualElement class="best-text">
                                <ui:Label name="match-best" text="" class="round-detail" />
                                <ui:Label name="match-best-sub" text="" class="muted small" />
                            </ui:VisualElement>
                            <ui:Button name="match-watch" text="Watch" class="btn btn--small" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:Label text="PLAYERS" class="h3 gap-s" />
                        <ui:VisualElement name="match-players" />
                    </ui:VisualElement>
                    <ui:Button name="match-done" text="I'm done" class="btn gap-m" />
                    <ui:Label name="match-feedback" text="" class="notice gap-m" />
                    <ui:Label name="match-tip" text="" class="muted small gap-m" />
                    <ui:Button name="match-leave" text="Leave lobby" class="link-quiet" />
                </ui:VisualElement>

            </ui:ScrollView>

            <!-- Compact layout only: the side panel is a sheet over the board; this is its handle and one-line summary
                 (tap or drag it to show the panel or the board). -->
            <ui:VisualElement name="sheet-head" class="sheet-head">
                <ui:VisualElement class="sheet-handle" picking-mode="Ignore" />
                <ui:VisualElement class="sheet-row" picking-mode="Ignore">
                    <ui:Label name="sheet-summary" text="" class="sheet-summary" picking-mode="Ignore" />
                    <ui:Label name="sheet-toggle" text="More" class="sheet-toggle" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settings" class="popover">
            <ui:Label text="SETTINGS" class="h3 gap-s" />
            <ui:VisualElement name="settings-list" />
            <ui:Label name="palette-label" class="setting-label palette-label" />
            <ui:VisualElement name="palette-list" class="swatches" />
            <ui:Label name="board-style-label" class="setting-label palette-label" />
            <ui:VisualElement name="board-style-list" class="swatches board-swatches" />
        </ui:VisualElement>

        <ui:VisualElement name="profile-popover" class="popover">
            <ui:Label text="PROFILE" class="h3 gap-s" />
            <ui:Label text="Your name" class="field-label" />
            <ui:TextField name="profile-name-field" max-length="20" class="field" />
            <ui:Label text="Shown in lobbies and on the daily leaderboard." class="muted small popover-note" />
            <ui:Label text="Playing as a guest" class="setting-label" style="margin-top: 16px;" />
            <ui:Label text="Your streak and daily results are saved in this browser. Accounts are coming later." class="muted small popover-note" />
        </ui:VisualElement>

        <ui:VisualElement name="leave-popover" class="popover popover--leave">
            <ui:Label name="leave-title" class="h2" />
            <ui:Label name="leave-body" class="muted small popover-note gap-m" />
            <ui:VisualElement class="row">
                <ui:Button name="leave-stay" text="Stay" class="btn btn--primary grow" />
                <ui:Button name="leave-confirm" text="Leave" class="btn grow leave-confirm" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="board-tip" text="Click a robot, then a dot to move it. Arrow keys and dragging work too." class="board-tip" picking-mode="Ignore" />
        <!-- The first-time tutorial's prompt, over the bottom of the board. -->
        <ui:VisualElement name="tutorial-card" class="tutorial-card">
            <ui:VisualElement class="tutorial-head">
                <ui:Label name="tutorial-badge" text="1" class="tutorial-badge" />
                <ui:Label name="tutorial-title" text="" class="tutorial-title" />
            </ui:VisualElement>
            <ui:Label name="tutorial-body" text="" class="tutorial-body" />
            <ui:VisualElement class="tutorial-foot">
                <ui:VisualElement name="tutorial-dots" class="tutorial-dots" />
                <ui:Button name="tutorial-skip" text="Skip tutorial" class="btn btn--ghost btn--small" />
                <ui:Button name="tutorial-done" text="Start playing" class="btn btn--primary btn--small" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="board-overlay" class="board-overlay" picking-mode="Ignore">
            <ui:Label name="overlay-caption" text="" class="overlay-caption" picking-mode="Ignore" />
            <ui:Label name="overlay-number" text="" class="overlay-number" picking-mode="Ignore" />
            <ui:Label name="overlay-hint" text="" class="overlay-hint" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- A phone held sideways: too short for either layout. -->
        <ui:VisualElement name="rotate-hint" class="rotate-hint">
            <ui:Label text="Turn your phone upright to play" class="h2" style="-unity-text-align: middle-center;" />
            <ui:Label text="Ricochet fits best in portrait on a phone." class="muted body" style="-unity-text-align: middle-center; margin-top: 8px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
