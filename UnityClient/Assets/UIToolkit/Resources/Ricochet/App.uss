/* The app's look: palette colours as variables, Nunito throughout. */
/* Palettes (Settings > Palette; Theme/Palette.cs lists them): AppUI puts .palette--<id> on #app. :root holds the default
   (Toybox night) for anything outside #app. */
:root {
    --bg: #1f1914;
    --nav: #171210;
    --panel: #2b231c;
    --panel-2: #382e25;
    --panel-hover: #43372c;
    --input: #221b15;
    --line: rgba(236, 222, 193, 0.35);
    --text: #fbf0d9;
    --muted: #c8b697;
    --nav-text: #ddcdb0;
    --body: #eadcc2;
    --action: #26914f;
    --action-hover: #2da35b;
    --on-action: #ffffff;
    --daily: #ffc233;
    --daily-hover: #ffcd55;
    --on-daily: #2b2117;
    --daily-tint: #2f2517;
    --daily-border: #f0b42e;
    --daily-soft: #4b3a1a;
    --daily-text: #ffd466;
    --good: #8fd9a8;
    --shortest: #4a4038;
    --rank-2: #d4c6ad;
    --rank-3: #d9a07a;
    --card-border: rgba(236, 222, 193, 0.7);
    --ink: #ecdec1;

    -unity-font: url("/Assets/Fonts/Nunito-Regular.ttf");
    -unity-font-definition: initial;
    color: var(--text);
    font-size: 15px;
}

.app { flex-grow: 1; flex-direction: row; color: var(--text); }

.palette--toynight {
    --bg: #1f1914;
    --nav: #171210;
    --panel: #2b231c;
    --panel-2: #382e25;
    --panel-hover: #43372c;
    --input: #221b15;
    --line: rgba(236, 222, 193, 0.35);
    --text: #fbf0d9;
    --muted: #c8b697;
    --nav-text: #ddcdb0;
    --body: #eadcc2;
    --action: #26914f;
    --action-hover: #2da35b;
    --on-action: #ffffff;
    --daily: #ffc233;
    --daily-hover: #ffcd55;
    --on-daily: #2b2117;
    --daily-tint: #2f2517;
    --daily-border: #f0b42e;
    --daily-soft: #4b3a1a;
    --daily-text: #ffd466;
    --good: #8fd9a8;
    --shortest: #4a4038;
    --rank-2: #d4c6ad;
    --rank-3: #d9a07a;
    --card-border: rgba(236, 222, 193, 0.7);
    --ink: #ecdec1;
}
.palette--night {
    --bg: #1c1713;
    --nav: #15110e;
    --panel: #28211b;
    --panel-2: #342b23;
    --panel-hover: #3f342a;
    --input: #1c1713;
    --line: #4a3d31;
    --text: #f3eadc;
    --muted: #bba98f;
    --nav-text: #d2c4ae;
    --body: #e2d7c6;
    --action: #3b6fd9;
    --action-hover: #4d7fe6;
    --on-action: #ffffff;
    --daily: #efb02e;
    --daily-hover: #f5bf4a;
    --on-daily: #241c14;
    --daily-tint: #2e2416;
    --daily-border: #5a4526;
    --daily-soft: #3d2f1b;
    --daily-text: #ffcf6b;
    --good: #8fd9a8;
    --shortest: #4d4439;
    --rank-2: #cfc6b8;
    --rank-3: #d9a07a;
    --card-border: rgba(0, 0, 0, 0);
}
.palette--indigo {
    --bg: #171a29;
    --nav: #12141f;
    --panel: #1f2336;
    --panel-2: #262b42;
    --panel-hover: #2f3552;
    --input: #171a29;
    --line: #3a4060;
    --text: #ecebf5;
    --muted: #a3a6bf;
    --nav-text: #c4c6da;
    --body: #d7d8e6;
    --action: #6a5be0;
    --action-hover: #7a6cf0;
    --on-action: #ffffff;
    --daily: #efb02e;
    --daily-hover: #f5bf4a;
    --on-daily: #1b1d2a;
    --daily-tint: #232032;
    --daily-border: #4a4030;
    --daily-soft: #3a3022;
    --daily-text: #ffcf6b;
    --good: #8fd9a8;
    --shortest: #4a4f66;
    --rank-2: #c9ccdd;
    --rank-3: #d9a07a;
    --card-border: rgba(0, 0, 0, 0);
}
.palette--table {
    --bg: #efe6d3;
    --nav: #e4d7bf;
    --panel: #fbf6ec;
    --panel-2: #eadfca;
    --panel-hover: #e0d2b8;
    --input: #f5eddd;
    --line: #c9b99c;
    --text: #2b2117;
    --muted: #6a5a45;
    --nav-text: #4f4232;
    --body: #3d3226;
    --action: #2f5fc4;
    --action-hover: #3a6bd2;
    --on-action: #ffffff;
    --daily: #e4a11b;
    --daily-hover: #eeb03a;
    --on-daily: #2b2117;
    --daily-tint: #fbf0d6;
    --daily-border: #e6c886;
    --daily-soft: #f4dfae;
    --daily-text: #7a5208;
    --good: #2e7d4f;
    --shortest: #d9d0bf;
    --rank-2: #6a6f80;
    --rank-3: #9a5a2e;
    --card-border: #e2d5bc;
}
.palette--toybox {
    --bg: #fff4dc;
    --nav: #ffe7b8;
    --panel: #ffffff;
    --panel-2: #f3ecdd;
    --panel-hover: #ebe1cc;
    --input: #fffaf0;
    --line: #2b2117;
    --text: #2b2117;
    --muted: #5f5244;
    --nav-text: #4a3e31;
    --body: #3a2f24;
    --action: #1f7a44;
    --action-hover: #258a4e;
    --on-action: #ffffff;
    --daily: #ffc233;
    --daily-hover: #ffcd55;
    --on-daily: #2b2117;
    --daily-tint: #fff0c9;
    --daily-border: #2b2117;
    --daily-soft: #ffe08a;
    --daily-text: #6b4500;
    --good: #1f7a44;
    --shortest: #e6dccb;
    --rank-2: #5f5244;
    --rank-3: #9a5a2e;
    --card-border: #2b2117;
}
.palette--teal {
    --bg: #0f2427;
    --nav: #0b1c1e;
    --panel: #153238;
    --panel-2: #1c3f45;
    --panel-hover: #234b52;
    --input: #0f2427;
    --line: #2d575d;
    --text: #e8f3f0;
    --muted: #a4c6c0;
    --nav-text: #c3dcd8;
    --body: #d3e6e2;
    --action: #f2a33a;
    --action-hover: #f6b252;
    --on-action: #1d1405;
    --daily: #ffd166;
    --daily-hover: #ffda80;
    --on-daily: #1d1405;
    --daily-tint: #1d3533;
    --daily-border: #4d5a3a;
    --daily-soft: #2f3d2c;
    --daily-text: #ffd98a;
    --good: #8fd9a8;
    --shortest: #3c5357;
    --rank-2: #c3d3d0;
    --rank-3: #d9a07a;
    --card-border: rgba(0, 0, 0, 0);
}
.palette--chalk {
    --bg: #22302a;
    --nav: #1a2520;
    --panel: #2a3b33;
    --panel-2: #34483f;
    --panel-hover: #3e554a;
    --input: #22302a;
    --line: #4f6a5d;
    --text: #f2f0e6;
    --muted: #b9c4b8;
    --nav-text: #d4dbd2;
    --body: #e0e3da;
    --action: #3a6fd8;
    --action-hover: #4a7fe6;
    --on-action: #ffffff;
    --daily: #f0c24b;
    --daily-hover: #f5cf68;
    --on-daily: #1f1a10;
    --daily-tint: #2f3b2c;
    --daily-border: #7d6a3a;
    --daily-soft: #3a4632;
    --daily-text: #ffd970;
    --good: #9fe0b4;
    --shortest: #45574f;
    --rank-2: #c9d0c6;
    --rank-3: #d9a07a;
    --card-border: rgba(242, 240, 230, 0.25);
}

/* Palette touches beyond colour: Toybox's thick ink outlines and press-down buttons, a soft edge on Table and Chalkboard cards.
   Toybox night: cream ink lines weighted by importance (bold on the main buttons, softer on cards, faint on the rest); the
   buttons' black press-down shadow is drawn by AppUI (Palette.PressShadow). */
.app.palette--toynight .card, .app.palette--toynight .popover, .app.palette--toynight .sheet-head { border-width: 2px; border-color: var(--card-border); }
.app.palette--toynight .sheet-head { border-bottom-width: 0; }
.app.palette--toynight .card--daily { border-color: var(--daily-border); }
.app.palette--toynight .btn { border-width: 2px; border-color: rgba(236, 222, 193, 0.45); }
.app.palette--toynight .btn--primary, .app.palette--toynight .btn--daily { border-width: 3px; border-color: var(--ink); }
.app.palette--table .card, .app.palette--chalk .card { border-width: 1px; border-color: var(--card-border); }
.app.palette--toybox .card, .app.palette--toybox .popover, .app.palette--toybox .sheet-head { border-width: 3px; border-color: var(--card-border); }
.app.palette--table .card--daily, .app.palette--chalk .card--daily, .app.palette--toybox .card--daily { border-color: var(--daily-border); }
.app.palette--toybox .sheet-head { border-bottom-width: 0; }
.app.palette--toybox .btn { border-width: 2px; border-bottom-width: 5px; border-color: var(--line); }
.app.palette--toybox .btn:active { border-bottom-width: 2px; }
.app.palette--toybox .btn--ghost { border-bottom-width: 2px; }
.app.palette--toybox .switch { border-width: 2px; border-color: var(--line); }
.app.palette--toybox .switch-knob { margin-left: 2px; }
.app.palette--toybox .switch.is-on .switch-knob { margin-left: 24px; }
.app.palette--toybox .stat, .app.palette--toybox .stepper { border-width: 2px; border-color: var(--line); }


/* ---- Navigation ---- */
.nav { width: 232px; flex-shrink: 0; background-color: var(--nav); padding: 24px 16px; }
.brand { flex-direction: row; align-items: center; padding: 4px 10px 22px 10px; }
.brand-dots { flex-direction: row; flex-wrap: wrap; width: 28px; }
.dot { width: 11px; height: 11px; border-radius: 6px; margin: 1px; }
.dot--red { background-color: #e0484d; }
.dot--blue { background-color: #3b74e6; }
.dot--green { background-color: #2f9e5b; }
.dot--yellow { background-color: #efb02e; }
.brand-name { font-size: 26px; margin-left: 10px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.app .nav-item {
    height: 46px; margin: 0 0 6px 0; padding: 0 12px; border-width: 0; border-radius: 12px;
    background-color: rgba(0, 0, 0, 0); color: var(--nav-text); font-size: 16px; -unity-text-align: middle-left;
    -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf");
}
.app .nav-item:hover { background-color: var(--panel); color: var(--text); }
.app .nav-item.is-active { background-color: var(--panel-2); color: var(--text); -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.spacer { flex-grow: 1; }
.profile { padding-top: 6px; margin-top: 6px; border-top-width: 1px; border-color: var(--panel-2); }
/* Opens the profile popover (name, guest note). */
.profile-button { padding: 8px 12px; border-radius: 12px; }
.profile-button:hover, .profile-button.is-active { background-color: var(--panel); }
.profile-row { flex-direction: row; align-items: center; }
.avatar { width: 34px; height: 34px; border-radius: 17px; background-color: #3b74e6; -unity-text-align: middle-center; font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); color: #ffffff; }
.profile-name { margin-left: 10px; flex-shrink: 1; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.profile-sub { font-size: 13px; color: var(--muted); margin-top: 6px; }

/* ---- Main area: the board stage and the side panel ---- */
.main { flex-grow: 1; flex-direction: row; padding: 28px 40px; }
.main--home { flex-direction: row-reverse; }
.stage { flex-grow: 1; flex-basis: 0; min-width: 320px; }
.stage-head { flex-direction: row; justify-content: space-between; align-items: center; min-height: 40px; }
.goal { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.goal-icon { width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.goal-label { font-size: 17px; margin-left: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.banner { padding: 7px 14px; border-radius: 10px; font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); flex-shrink: 0; margin-left: 12px; }
/* In the row under the board during a controllable replay, in place of Undo and Shortest. */
.replay-bar { flex-direction: row; flex-shrink: 0; }
.board-area { flex-grow: 1; margin: 10px 0; min-height: 300px; }
.board-controls { flex-direction: row; margin: 0 -5px; }
/* First visit only: how to move, floating over the bottom of the board until the first move. */
.board-tip { position: absolute; display: none; padding: 8px 16px; border-radius: 10px; background-color: rgba(18, 20, 31, 0.88); color: #ecebf5; font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); -unity-text-align: middle-center; }
.board-tip.is-visible { display: flex; }
.tutorial-card { position: absolute; display: none; padding: 14px 16px 12px; border-radius: 14px; background-color: var(--panel); border-width: 2px; border-color: var(--ink); }
.tutorial-card.is-visible { display: flex; }
.tutorial-head { flex-direction: row; align-items: center; }
.tutorial-badge { width: 28px; height: 28px; border-radius: 8px; background-color: var(--daily); color: var(--on-daily); font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); -unity-text-align: middle-center; margin-right: 10px; flex-shrink: 0; }
.tutorial-badge.is-solved { background-color: var(--action); color: var(--on-action); }
.tutorial-title { flex-grow: 1; flex-shrink: 1; font-size: 18px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); white-space: normal; color: var(--text); }
.tutorial-body { font-size: 15px; white-space: normal; color: var(--body); margin-top: 6px; margin-left: 38px; min-height: 60px; } /* 3 lines: every step's card the same size */
.tutorial-foot { flex-direction: row; align-items: center; margin-top: 10px; margin-left: 38px; }
.tutorial-dots { flex-direction: row; flex-grow: 1; }
.tutorial-dot { width: 8px; height: 8px; border-radius: 3px; margin-right: 6px; background-color: var(--line); }
.tutorial-dot.is-on { background-color: var(--daily); }
.tutorial-dot.is-current { width: 20px; }
.app .tutorial-foot .btn { height: 34px; padding: 0 14px; font-size: 14px; margin-left: 8px; }
.app .tutorial-replay { margin-top: 14px; align-self: flex-start; }

/* The countdown / "finding a board" layer, placed over the board itself. */
.board-overlay { position: absolute; display: none; background-color: rgba(12, 12, 24, 0.66); border-radius: 14px; align-items: center; justify-content: center; }
.board-overlay.is-visible { display: flex; }
.overlay-caption { font-size: 24px; color: #ffffff; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); -unity-text-align: middle-center; white-space: normal; }
.overlay-number { font-size: 150px; color: #ffffff; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); -unity-text-align: middle-center; }
.overlay-hint { font-size: 16px; color: #d7d8e6; margin-top: 8px; -unity-text-align: middle-center; }

.side { width: 380px; flex-shrink: 0; margin-left: 36px; }
.main--home .side { width: 560px; margin-left: 0; margin-right: 40px; }
.screen { display: none; }
.screen.is-visible { display: flex; }

/* ---- Text ---- */
.h1 { font-size: 34px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); white-space: normal; }
.h2 { font-size: 22px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); white-space: normal; }
.h3 { font-size: 13px; color: var(--muted); letter-spacing: 1px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.body { font-size: 16px; white-space: normal; color: var(--body); }
.muted { color: var(--muted); white-space: normal; }
.small { font-size: 14px; }

/* ---- Cards ---- */
.card { background-color: var(--panel); border-radius: 20px; padding: 22px; margin-bottom: 18px; }
.card--daily { background-color: var(--daily-tint); border-width: 1px; border-color: var(--daily-border); }
.card-head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.card-icon { width: 44px; height: 44px; border-radius: 12px; background-color: var(--daily); margin-right: 12px; align-items: center; justify-content: center; }
.card-icon-star { width: 26px; height: 26px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--on-daily); }
.card-title { flex-grow: 1; }
.pill { padding: 5px 12px; border-radius: 8px; font-size: 14px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.pill--daily { background-color: var(--daily-soft); color: var(--daily-text); }
.row { flex-direction: row; align-items: center; }
.row--spread { justify-content: space-between; }
.grow { flex-grow: 1; }

/* ---- Buttons ---- */
.app .btn {
    height: 48px; margin: 0; padding: 0 22px; border-width: 0; border-radius: 13px; font-size: 16px;
    -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); -unity-text-align: middle-center;
    background-color: var(--panel-2); color: var(--text);
}
.app .btn:hover { background-color: var(--panel-hover); }
.app .btn:disabled { opacity: 0.4; }
.app .btn--primary { background-color: var(--action); color: var(--on-action); }
.app .btn--primary:hover { background-color: var(--action-hover); }
.app .btn--daily { background-color: var(--daily); color: var(--on-daily); }
.app .btn--daily:hover { background-color: var(--daily-hover); }
.app .btn--ghost { background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: var(--line); }
.app .btn--small { height: 40px; padding: 0 14px; font-size: 15px; }
.app .btn--square { width: 48px; padding: 0; }
.board-controls .btn { flex-grow: 1; flex-basis: 0; margin: 0 5px; }
/* Replay buttons keep their own widths in the row; one width for Pause / Play / Again so nothing shifts. */
.board-controls .replay-bar .btn { flex-grow: 0; flex-basis: auto; }
/* How to play's key list: the key on the left, what it does beside it. */
.key-list { margin-bottom: 12px; }
.key-row { flex-direction: row; margin-bottom: 2px; }
.key-name { width: 100px; flex-shrink: 0; font-size: 13px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.key-what { flex-grow: 1; font-size: 13px; color: var(--muted); }
.app #replay-pause { width: 96px; padding: 0; }

/* ---- Daily result ---- */
.stat { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: center; background-color: var(--input); border-radius: 12px; padding: 10px 8px; margin-right: 8px; }
.stat--last { margin-right: 0; }
.stat-value { font-size: 24px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.stat-value--daily { color: var(--daily-text); }
.stat-value.stat-value--long { font-size: 18px; }
.stat-label { font-size: 13px; color: var(--muted); white-space: normal; -unity-text-align: upper-center; }
.squares { flex-direction: row; flex-wrap: wrap; }
.square { width: 28px; height: 28px; border-radius: 6px; margin: 0 5px 5px 0; align-items: center; justify-content: center; }
.square-arrow { width: 16px; height: 16px; -unity-background-scale-mode: scale-to-fit; }
.notice { margin-top: 10px; font-size: 14px; color: var(--daily-text); -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); white-space: normal; }
.lb-row { flex-direction: row; align-items: center; padding: 7px 8px; border-radius: 10px; }
.lb-row.is-me { background-color: var(--panel-2); }
.lb-rank { width: 28px; font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); color: var(--muted); }
.lb-rank--1 { color: var(--daily-text); }
.lb-rank--2 { color: var(--rank-2); }
.lb-rank--3 { color: var(--rank-3); }
.lb-name { flex-grow: 1; font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lb-moves { width: 40px; font-size: 15px; -unity-text-align: middle-right; }
.lb-time { width: 64px; margin-left: 6px; font-size: 15px; color: var(--muted); -unity-text-align: middle-right; }

/* ---- Lobby and match ---- */
.code-big { font-size: 40px; letter-spacing: 6px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.player-row { flex-direction: row; align-items: center; padding: 8px 10px; border-radius: 12px; }
.player-row.is-me { background-color: var(--panel-2); }
.player-avatar { width: 34px; height: 34px; border-radius: 17px; margin-right: 12px; -unity-text-align: middle-center; font-size: 15px; color: #ffffff; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); flex-shrink: 0; }
.player-name { font-size: 16px; margin-right: 8px; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.tag { font-size: 12px; padding: 2px 8px; border-radius: 6px; margin-right: 4px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); flex-shrink: 0; }
.tag--host { background-color: var(--panel-2); color: var(--muted); }
.player-row.is-me .tag--host { background-color: var(--panel); }
.tag--lead { background-color: var(--daily); color: var(--on-daily); }
.tag--done { color: var(--good); padding-left: 0; }
.tag--away { color: var(--muted); padding-left: 0; }
.player-score { margin-left: auto; padding-left: 8px; font-size: 22px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); flex-shrink: 0; }
.timer-value { font-size: 44px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.timer-value.is-bumped { color: var(--good); }
.app .solution-btn { margin-bottom: 8px; -unity-text-align: middle-left; }
.app .solution-btn--shortest { background-color: var(--shortest); }
.mini-stepper { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 10px; }
.mini-stepper-value { min-width: 74px; font-size: 16px; -unity-text-align: middle-center; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.app .mini-stepper .btn { width: 36px; height: 36px; padding: 0; border-radius: 10px; font-size: 18px; }

/* ---- Inputs ---- */
.field { margin: 0; flex-grow: 1; }
.app .field .unity-base-text-field__input {
    height: auto; padding: 11px 14px; border-width: 1px; border-radius: 12px; border-color: var(--line);
    background-color: var(--input); color: var(--text); font-size: 17px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf");
    /* Even padding instead of a fixed height: the cursor sits at the text line's top, so the line must be centred. */
    /* The default theme's cursor is dark (made for light fields). */
    --unity-cursor-color: var(--text); --unity-selection-color: rgba(106, 91, 224, 0.45);
}
.app .field:focus .unity-base-text-field__input { border-color: var(--action); }
.app .field--code .unity-base-text-field__input { letter-spacing: 3px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.field-label { font-size: 14px; color: var(--muted); margin-bottom: 6px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }

/* ---- Switches and the stepper ---- */
.app .switch { width: 52px; height: 30px; border-radius: 15px; border-width: 0; margin: 0; padding: 0; background-color: var(--panel-2); justify-content: center; }
.app .switch:hover { background-color: var(--panel-hover); }
.app .switch.is-on { background-color: var(--action); }
.switch-knob { width: 22px; height: 22px; border-radius: 11px; background-color: #ffffff; margin-left: 4px; }
.switch.is-on .switch-knob { margin-left: 26px; }
.setting-row { flex-direction: row; align-items: center; justify-content: space-between; min-height: 44px; }
.setting-label { font-size: 16px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.stepper { flex-direction: row; align-items: center; justify-content: space-between; background-color: var(--input); border-radius: 12px; padding: 5px; }
.stepper-value { font-size: 17px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }

/* ---- Settings popover ---- */
.popover { position: absolute; left: 248px; bottom: 24px; width: 290px; display: none; background-color: var(--panel); border-radius: 18px; padding: 16px 18px; border-width: 1px; border-color: var(--line); }
.popover.is-open { display: flex; }
.popover-note { margin-top: 6px; white-space: normal; }
/* Asks before a nav tab leaves the lobby: next to the nav, near the top. */
.popover--leave { top: 90px; bottom: auto; }
.app .leave-confirm { margin-left: 10px; }
.palette-label { margin-top: 12px; margin-bottom: 8px; }
.swatches { flex-direction: row; justify-content: space-between; }
.app .swatch { width: 32px; height: 32px; margin: 0; padding: 0; border-radius: 9px; border-width: 2px; border-color: var(--line); align-items: center; justify-content: center; }
.app .swatch.is-active { border-width: 3px; border-color: var(--text); }
.swatch-dot { width: 14px; height: 14px; border-radius: 4px; }
/* Boards: fewer swatches, kept together at the start. */
.app .board-swatches { justify-content: flex-start; }
.app .board-swatches .swatch { margin-right: 10px; }

/* ---- The side panel's scrollbar: thin, dark, no arrow buttons ---- */
.side .unity-scroller--vertical { width: 8px; margin-left: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.side .unity-scroller__low-button, .side .unity-scroller__high-button { display: none; }
.side .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.side .unity-base-slider__dragger { background-color: var(--panel-2); border-width: 0; border-radius: 4px; }
.side .unity-base-slider__dragger:hover { background-color: var(--panel-hover); }

/* ---- Medium: the desktop layout under 1400 panel units wide (tablets held sideways, small windows; AppUI adds
   .app--medium). Narrower sidebar, side panel and margins so the board keeps its room. ---- */
.app--medium .nav { width: 196px; padding: 20px 12px; }
.app--medium .main { padding: 20px 24px; }
.app--medium .side { width: 330px; margin-left: 24px; }
.app--medium .main--home .side { width: 440px; margin-left: 0; margin-right: 24px; }

/* ---- Compact layout: phones and tablets held upright (AppUI adds .app--compact; sized in CSS pixels) ----
   Top bar, the board with its controls, the screen's panel below it, the nav as a bottom tab bar. Everything here is
   scoped to .app--compact so the desktop layout above never changes. */
.topbar { display: none; }
.sheet-head { display: none; }
.app--compact .sheet-head {
    display: flex; position: absolute; height: 48px; padding: 6px 14px 0 14px; background-color: var(--panel);
    border-top-left-radius: 16px; border-top-right-radius: 16px;
}
.sheet-handle { width: 40px; height: 4px; border-radius: 2px; background-color: var(--line); align-self: center; margin-bottom: 8px; }
.sheet-row { flex-direction: row; align-items: center; }
.sheet-summary { flex-grow: 1; flex-shrink: 1; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.sheet-toggle { flex-shrink: 0; margin-left: 10px; font-size: 14px; color: var(--muted); -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
/* The panel under the sheet's head: opaque, since it slides up over the board. */
.app--compact .side { position: absolute; background-color: var(--bg); padding-top: 12px; }
.rotate-hint { display: none; }
/* Only in the compact layout (e.g. the home practice card's button: on desktop the board is right there). */
.compact-only { display: none; }
.app--compact .compact-only { display: flex; }
.app .home-practice-open { margin-top: 14px; }
.app--compact { flex-direction: column; }
.app--compact .topbar { display: flex; flex-direction: row; align-items: center; flex-shrink: 0; padding: 8px 12px; background-color: var(--nav); }
.topbar-name { font-size: 20px; margin-left: 8px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.app .topbar-settings { margin-right: 10px; }
.topbar-avatar { width: 36px; height: 36px; border-radius: 18px; }

.app--compact .nav { width: auto; flex-direction: row; flex-shrink: 0; padding: 6px 6px; border-top-width: 1px; border-color: var(--panel-2); }
.app--compact .nav .brand, .app--compact .nav .spacer, .app--compact #nav-settings, .app--compact .nav .profile { display: none; }
.app--compact .nav-item { flex-grow: 1; flex-basis: 0; height: 48px; margin: 0 3px; padding: 0 4px; font-size: 15px; -unity-text-align: middle-center; }

.app--compact .main { flex-direction: column; padding: 8px 12px 0 12px; }
.app--compact .main--home .stage { display: none; }
.app--compact .stage { flex-grow: 0; flex-basis: auto; min-width: 0; flex-shrink: 0; }
.app--compact .stage-head { min-height: 34px; height: 34px; }
.app--compact .goal-label { font-size: 15px; }
.app--compact .banner { display: none; }
.app--compact .board-area { flex-grow: 0; min-height: 0; margin: 6px 0; }
.app--compact .board-tip { white-space: normal; }
.app--compact .tutorial-card { padding: 10px 12px 10px; }
/* Fixed room for a 2-line title and 3 lines of text whatever the step, so the card keeps its size exactly. */
.app--compact .tutorial-title { font-size: 15px; margin-right: 112px; height: 50px; -unity-text-align: middle-left; }
.app--compact .tutorial-body { font-size: 13px; margin-left: 0; margin-top: 4px; height: 60px; }
/* Phones: Skip / Start playing up beside the title and no dots, so the card is short enough to sit over the board's bottom rows. */
.app--compact .tutorial-foot { position: absolute; top: 10px; right: 12px; margin: 0; }
.app--compact .tutorial-dots { display: none; }
.app.app--compact .tutorial-foot .btn { margin-left: 0; height: 32px; padding: 0 12px; font-size: 13px; }
.app--compact .board-controls { margin: 0 -4px; }
.app--compact .board-controls .btn { height: 44px; margin: 0 4px; padding: 0 6px; font-size: 15px; }
.app--compact #replay-pause { width: 76px; }
.app--compact .board-controls .btn--square { width: 44px; }
.app--compact .side, .app--compact .main--home .side { width: auto; margin: 0; }

.app--compact .h1 { font-size: 26px; }
.app--compact .card { padding: 16px; border-radius: 16px; margin-bottom: 12px; }
.app--compact .popover { left: 12px; right: 12px; top: 60px; bottom: auto; width: auto; }

.app--rotate .rotate-hint { display: flex; position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 24px; align-items: center; justify-content: center; background-color: var(--bg); }

/* ---- Spacing utilities (last, so they win over the components above) ---- */
.app .gap-s { margin-bottom: 8px; }
.app .gap-m { margin-bottom: 14px; }
.app .gap-l { margin-bottom: 22px; }

/* ---- Lobby and match panels (2026-10-27 redesign) ---- */
.app .card.card--gold { border-width: 2px; border-color: var(--daily-border); }
.app.palette--toynight .card.card--gold { border-color: var(--daily-border); }
.code-actions { flex-direction: column; align-items: stretch; margin-left: 10px; }
.app .code-actions .btn { margin-bottom: 8px; }
.lobby-alone { margin-top: 6px; padding-left: 10px; }
.app .link-quiet { align-self: center; background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 2px 0 8px 0; padding: 6px 12px;
    color: var(--muted); font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.app .link-quiet:hover { color: var(--text); background-color: rgba(0, 0, 0, 0); }
.match-head { align-items: flex-end; }
.match-sub { margin-bottom: 6px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.timer-row { align-items: flex-end; margin-bottom: 4px; }
.timer-unit { margin-left: 10px; margin-bottom: 7px; color: var(--muted); }
.timer-unit.is-bumped { color: var(--good); }
.round-detail { font-size: 20px; white-space: normal; margin-bottom: 4px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.round-progress { height: 6px; border-radius: 3px; background-color: var(--panel-2); margin-top: 12px; overflow: hidden; }
.round-progress-fill { height: 100%; width: 0; border-radius: 3px; background-color: var(--daily); }
.best-box { flex-direction: row; align-items: center; margin-top: 12px; padding-top: 12px; border-top-width: 1px; border-color: var(--line); }
.best-text { flex-grow: 1; flex-shrink: 1; margin-right: 10px; }
.best-text .round-detail { margin-bottom: 2px; }
.settings-group { font-size: 14px; color: var(--nav-text); margin-top: 6px; margin-bottom: 2px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.settings-divider { height: 1px; background-color: var(--line); margin: 10px 0 4px 0; opacity: 0.6; }
.setting-hint { font-size: 13px; color: var(--muted); white-space: normal; margin-top: -6px; margin-bottom: 6px; }
.setting-row--view { min-height: 36px; }
.setting-value { font-size: 16px; flex-shrink: 0; margin-left: 10px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.player-score-box { margin-left: auto; padding-left: 8px; align-items: flex-end; flex-shrink: 0; }
.player-score-box .player-score { margin-left: 0; padding-left: 0; }
.player-score-of { margin-left: 4px; font-size: 14px; color: var(--muted); -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.pips { flex-direction: row; margin-top: 3px; }
.pip { width: 12px; height: 5px; border-radius: 3px; margin-left: 3px; background-color: var(--panel-2); }
.player-row.is-me .pip { background-color: var(--panel-hover); }
.pip.is-on, .player-row.is-me .pip.is-on { background-color: var(--action); }
.rank { width: 24px; margin-right: 6px; font-size: 16px; color: var(--muted); -unity-text-align: middle-center; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); flex-shrink: 0; }
.rank--first { color: var(--daily-text); }
.tag--left { color: var(--muted); border-width: 1px; border-color: var(--line); }
.app .history-row { flex-direction: row; justify-content: space-between; align-items: center; height: 44px; padding: 0 14px; margin-bottom: 8px; }
.app .history-row.is-selected { border-color: var(--daily-border); }
.history-row-text { font-size: 15px; -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; }
.history-row-meta { font-size: 13px; color: var(--muted); margin-left: 8px; flex-shrink: 0; }
.history-detail { padding: 2px 0 6px 14px; }

/* ---- Daily: leaderboard switch, past puzzles strip and calendar (2026-10-28) ---- */
.seg { flex-direction: row; background-color: var(--input); border-radius: 10px; padding: 3px; }
.app .seg-btn { height: 30px; margin: 0; padding: 0 12px; border-width: 0; border-radius: 8px; background-color: rgba(0, 0, 0, 0);
    font-size: 14px; color: var(--muted); -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.app .seg-btn:hover { color: var(--text); background-color: rgba(0, 0, 0, 0); }
.app .seg-btn.is-on, .app .seg-btn.is-on:hover { background-color: var(--panel-hover); color: var(--text); }
.lb-streak { width: 84px; font-size: 15px; -unity-text-align: middle-right; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
/* "active" (the longest streak is still going) or "now on N" (a newer one is). */
.lb-streak-tag { flex-shrink: 0; margin-left: 6px; font-size: 13px; color: var(--muted); -unity-text-align: middle-right; }
.lb-streak-tag.is-active { color: var(--action); -unity-font: url("/Assets/Fonts/Nunito-Bold.ttf"); }
.strip { flex-direction: row; }
.cal-row { flex-direction: row; }
.cal-dow { flex-grow: 1; flex-basis: 0; margin: 0 2px 4px 2px; font-size: 12px; color: var(--muted); -unity-text-align: middle-center;
    -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.app .cal-cell { flex-grow: 1; flex-basis: 0; min-width: 0; height: 38px; margin: 2px; padding: 0; border-width: 2px; border-radius: 8px;
    border-color: rgba(0, 0, 0, 0); background-color: var(--panel-2); color: var(--muted); font-size: 15px;
    -unity-text-align: middle-center; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.app .cal-cell:hover { border-color: var(--line); }
.app .strip-day { height: 52px; flex-direction: column; justify-content: center; align-items: center; }
.strip-dow { font-size: 10px; letter-spacing: 1px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
.strip-num { font-size: 16px; -unity-font: url("/Assets/Fonts/Nunito-ExtraBold.ttf"); }
/* Like Wordle: green = exactly right (perfect), yellow = close (solved, not the shortest). */
.app .cal-cell--solved { background-color: var(--daily); color: var(--on-daily); }
.app .cal-cell--perfect { background-color: var(--action); color: var(--on-action); }
/* Today: its number in gold, no fill or ring (a ring means "solved later"). */
.app .cal-cell--today { background-color: rgba(0, 0, 0, 0); color: var(--daily-text); }
/* Solved later: a ring in the later result's colour (over the day's fill when a later play made it perfect). */
.app .cal-cell.cal-ring { border-width: 3px; color: var(--text); }
.app .cal-cell.cal-ring--solved, .app .cal-cell.cal-ring--solved:hover { border-color: var(--daily); }
.app .cal-cell.cal-ring--perfect, .app .cal-cell.cal-ring--perfect:hover { border-color: var(--action); }
.legend-swatch.cal-ring--solved { border-color: var(--daily); }
.app .cal-cell--solved.cal-ring, .app .cal-cell--perfect.cal-ring { color: var(--on-daily); }
.legend-swatch.legend-ring { border-width: 2px; background-color: rgba(0, 0, 0, 0); }
.app .cal-cell--off { opacity: 0.25; }
.app .cal-cell--off:hover { border-color: rgba(0, 0, 0, 0); }
.app .cal-cell--empty { opacity: 0; }
.app .cal-cell.is-selected { border-color: var(--text); border-width: 3px; }
.cal-seen { position: absolute; top: 3px; right: 3px; width: 6px; height: 6px; border-radius: 3px; background-color: var(--muted); }
.cal-cell--solved .cal-seen, .cal-cell--perfect .cal-seen { background-color: rgba(0, 0, 0, 0.45); }
.legend { flex-direction: row; flex-wrap: wrap; }
.legend-item { flex-direction: row; align-items: center; margin: 0 12px 4px 0; }
.legend-swatch { width: 12px; height: 12px; border-radius: 3px; margin-right: 5px; border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.legend-swatch.cal-seen { position: relative; top: 0; right: 0; width: 6px; height: 6px; margin: 0 5px 0 3px; border-width: 0; }
.legend-text { font-size: 13px; color: var(--muted); }
/* The strip's labels take the day's text colour. */
.app .cal-cell Label { color: var(--muted); }
.app .cal-cell--none.cal-ring Label { color: var(--text); }
.app .cal-cell--solved Label { color: var(--on-daily); }
.app .cal-cell--perfect Label { color: var(--on-action); }
.app .cal-cell--today Label { color: var(--daily-text); }
.legend-swatch.cal-cell--none { background-color: var(--panel-2); }
/* Stat tiles: one height in a row, and room for "best possible" on one line beside the panel's scrollbar. */
.app #daily-stats, .app #archive-stats { align-items: stretch; }
.app .stat { padding: 10px 4px; justify-content: center; }
/* The strip's two lines, centred in the day. */
.app .strip-dow, .app .strip-num { margin: 0; padding: 0; -unity-text-align: middle-center; }
.app .strip-dow { margin-bottom: 1px; }
/* The picked day stands out over any ring. */
.app .cal-row .cal-cell.is-selected, .app .cal-row .cal-cell.is-selected:hover { border-color: var(--text); border-width: 3px; }
